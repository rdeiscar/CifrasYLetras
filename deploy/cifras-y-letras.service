[Unit]
Description=Cifras y Letras - servidor del juego multijugador
After=network.target

[Service]
Type=simple
User=cifras
Group=cifras
WorkingDirectory=/opt/cifras-y-letras
EnvironmentFile=-/etc/cifras-y-letras.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node server/index.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/cifras-y-letras

[Install]
WantedBy=multi-user.target